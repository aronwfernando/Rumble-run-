{
  "name": "rumble-run",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted multiplayer bean racing with seeded procedural tournaments.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server.js --dev",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server.js",
    "test": "node --test tests/*.test.js",
    "generate-map": "node scripts/generate-map.js",
    "check-maps": "node scripts/check-maps.js",
    "benchmark": "node scripts/benchmark.js",
    "preview-courses": "node scripts/preview-courses.js"
  },
  "dependencies": {
    "cannon-es": "0.20.0",
    "compression": "1.8.2",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "three": "0.186.1"
  },
  "devDependencies": {
    "vite": "8.3.2"
  }
}
